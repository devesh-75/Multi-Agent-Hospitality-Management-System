# Docker Compose deployment settings.
# Replace the sample password and use the same value in DATABASE_URL.
POSTGRES_DB=hospitality_db
POSTGRES_USER=hospitality
POSTGRES_PASSWORD=replace-this-with-a-long-random-password
DATABASE_URL=postgresql+psycopg2://hospitality:replace-this-with-a-long-random-password@postgres:5432/hospitality_db

SOURCE_DATA_DIR=./data/raw
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
DASHBOARD_HOST_PORT=3000

# Use a JSON array. The dashboard uses a same-origin API proxy by default.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
