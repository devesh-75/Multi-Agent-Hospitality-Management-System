# =====================================================================
# AGENTIC FINTECH IN HOSPITALITY SERVICES - ENVIRONMENT CONFIGURATION
# =====================================================================

ENVIRONMENT=development
DEBUG=true

# Operational Database
# Default: Local SQLite (Instant standalone execution)
DATABASE_URL=sqlite:///./data/hospitality.db

# Alternative: PostgreSQL Instance (when running Docker or local postgres service)
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/hospitality_db

# Read-only Source Datasets Directory
SOURCE_DATA_DIR=C:\Users\deves\Downloads\project

# Apache Kafka Event Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hospitality_knowledge
QDRANT_ENABLED=false

# AI & LLM Integration (Optional - System executes deterministic rules without it)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
